# ===== Base de données (Postgres — ex. Neon via Vercel Storage) =====
DATABASE_URL=

# ===== Connexion par e-mail (NextAuth / Auth.js) =====
AUTH_RESEND_KEY=
EMAIL_FROM="Horosphère <onboarding@resend.dev>"
AUTH_SECRET=

# ===== IA (génération des horoscopes) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ===== Paiement =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price ID générés par `npm run setup:stripe` (ou créés à la main dans le Dashboard Stripe)
STRIPE_PRICE_PACK_INITIATION=
STRIPE_PRICE_PACK_EVEIL=
STRIPE_PRICE_PACK_CONNEXION=
STRIPE_PRICE_PACK_ILLUMINATION=
STRIPE_PRICE_PACK_ETERNITE=
STRIPE_PRICE_SUB_ESSENTIEL=
STRIPE_PRICE_SUB_PREMIUM=
STRIPE_PRICE_SUB_VIP=

# ===== Cron (protège /api/cron/expire-credits) =====
CRON_SECRET=
